<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>14</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsRoslynComponent>true</IsRoslynComponent>
		<AnalyzerLanguage>cs</AnalyzerLanguage>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<BuildOutputTargetFolder>analyzers</BuildOutputTargetFolder>

		<!-- this is a development dependency -->
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<IncludeSymbols>false</IncludeSymbols>
		<DevelopmentDependency>true</DevelopmentDependency>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

		<!-- CI injected versioning -->
		<VersionPrefix>0.0.0</VersionPrefix>
		<VersionSuffix>CI-INJECTED</VersionSuffix>
	</PropertyGroup>

	<!--Nuget packaging-->
	<PropertyGroup>
		<PackageId>Wkg.EntityFrameworkCore.Discovery.SourceGeneration</PackageId>
		<Title>WKG Entity Framework Core Model Discovery Source Generator</Title>
		<IsPackable>true</IsPackable>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/WKG-Software-GmbH/wkg-entity-framework-core</RepositoryUrl>
		<PackageProjectUrl>https://github.com/WKG-Software-GmbH/wkg-entity-framework-core</PackageProjectUrl>
		<Description>
			Wkg.EntityFrameworkCore.Discovery.SourceGeneration provides a Roslyn Source Generator to assist in the discovery of Entity Framework Core models using attributes, enabling compile-time model discovery of distributed fluent API configurations.
		</Description>
		<Company>WKG Software GmbH</Company>
		<Authors>WKG Software GmbH,Frederik Höft</Authors>
		<Copyright>Copyright (c) WKG Software GmbH 2025</Copyright>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageType>Dependency</PackageType>
		<PackageTags>
			entity-framework-core;efcore;orm;orm-policy-validation;orm-configuration;efcore-extension
		</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<None Include="_Assets\logo.png" Pack="true" PackagePath="\" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	
	<ItemGroup>
	  <EmbeddedResource Include="ModelLoaderAttribute.cs" />
	  <EmbeddedResource Include="AssemblyDiscoveryFailureBehavior.cs" />
	  <EmbeddedResource Include="ModelDiscoveryFilterAttribute.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
		<PackageReference Include="PolySharp" Version="1.15.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- Create nuget package as analyzer -->
		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>
</Project>
